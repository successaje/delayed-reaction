# Port for the local Node server.
PORT=8787
# Comma-separated browser origins allowed to call the API. Empty allows any origin
# (safe because auth uses bearer tokens, not cookies).
CORS_ORIGINS=
# Where relative media URLs in data/programs.json are served from.
MEDIA_BASE_URL=http://localhost:3000/media/
# Optional: path to a different program catalog.
# PROGRAMS_PATH=./data/programs.json
