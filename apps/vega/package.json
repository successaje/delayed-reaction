{
  "name": "@delayed-reaction/vega",
  "version": "0.1.0",
  "private": true,
  "description": "Deract for Fire TV on Vega OS.",
  "scripts": {
    "start": "react-native start",
    "build": "react-native build-kepler --build-type Release",
    "build:debug": "react-native build-kepler --build-type Debug",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf build buildinfo.json dist",
    "bundle": "mkdir -p build/ci/assets && react-native bundle --entry-file index.js --platform kepler --dev false --bundle-output build/ci/index.bundle --assets-dest build/ci/assets",
    "test": "yarn bundle"
  },
  "dependencies": {
    "@amazon-devices/react-native-async-storage__async-storage": "~2.1.9000000001",
    "@amazon-devices/react-native-kepler": "2.1.0+rn0.72.0",
    "@amazon-devices/react-native-w3cmedia": "~2.3.2",
    "@delayed-reaction/tv-ui": "workspace:*",
    "react": "18.2.0",
    "react-native": "0.72.0"
  },
  "devDependencies": {
    "@amazon-devices/kepler-cli-platform": "^0",
    "@babel/core": "^7.26.0",
    "@babel/traverse": "^7.26.0",
    "@react-native-community/cli": "17.0.1",
    "@react-native-community/cli-tools": "^11.0.0",
    "@react-native/js-polyfills": "^0.72.1",
    "@react-native/metro-config": "^0.72.6",
    "@tsconfig/react-native": "^3.0.2",
    "@types/react": "^18.0.24",
    "metro-react-native-babel-preset": "^0.76.5",
    "typescript": "~5.6.3"
  },
  "kepler": {
    "projectType": "application",
    "appName": "DelayedReaction",
    "targets": [
      "tv"
    ]
  }
}
